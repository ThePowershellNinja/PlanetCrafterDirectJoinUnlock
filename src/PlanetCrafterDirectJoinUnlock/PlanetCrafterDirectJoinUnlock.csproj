<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>PlanetCrafterDirectJoinUnlock</AssemblyName>
    <RootNamespace>PlanetCrafterDirectJoinUnlock</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">$(PLANETCRAFTER_GAME_DIR)</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == '' and '$(GameDir)' != ''">$(GameDir)/BepInEx</BepInExDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and '$(GameDir)' != ''">$(GameDir)/Planet Crafter_Data/Managed</ManagedDir>
    <OutputPath>$(MSBuildProjectDirectory)/../../package/BepInEx/plugins/PlanetCrafterDirectJoinUnlock/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <Target Name="ValidatePlanetCrafterReferences" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(GameDir)' == ''"
      Text="Set the GameDir MSBuild property or PLANETCRAFTER_GAME_DIR environment variable to your The Planet Crafter install directory." />
    <Error
      Condition="!Exists('$(BepInExDir)/core/BepInEx.dll')"
      Text="BepInEx.dll was not found at '$(BepInExDir)/core/BepInEx.dll'. Install BepInEx 5 into the game folder or override BepInExDir." />
    <Error
      Condition="!Exists('$(BepInExDir)/core/0Harmony.dll')"
      Text="0Harmony.dll was not found at '$(BepInExDir)/core/0Harmony.dll'. Install BepInEx 5 into the game folder or override BepInExDir." />
    <Error
      Condition="!Exists('$(ManagedDir)/UnityEngine.dll')"
      Text="UnityEngine.dll was not found at '$(ManagedDir)/UnityEngine.dll'. Verify GameDir points to your The Planet Crafter install folder." />
    <Error
      Condition="!Exists('$(ManagedDir)/UnityEngine.CoreModule.dll')"
      Text="UnityEngine.CoreModule.dll was not found at '$(ManagedDir)/UnityEngine.CoreModule.dll'. Verify GameDir points to your The Planet Crafter install folder." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
